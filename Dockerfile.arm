FROM arm64v8/node:24-bookworm-slim

ENV NODE_ENV=production

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends imagemagick ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY package.json ./
RUN npm install --production --unsafe-perm=true \
    && npm cache clean --force

COPY . ./

RUN mkdir -p /app/public/storage \
    && chown -R node:node /app

USER node

EXPOSE 3000
VOLUME ["/app/public/storage"]

CMD ["npm", "start"]
