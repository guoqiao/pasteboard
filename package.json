{
  "name": "pasteboard",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "npm run build:server && npm run build:client",
    "build:server": "tsc -p tsconfig.json",
    "build:client": "tsc -p tsconfig.client.json && node dist/scripts/build-assets.js",
    "start": "node dist/app.js",
    "run-local": "npm run build && LOCAL=true node dist/app.js"
  },
  "dependencies": {
    "express": "3.2.0",
    "ejs": "0.8.0",
    "knox": "0.9.2",
    "formidable": "1.0.11",
    "websocket": "1.0.8",
    "easyimage": "0.1.3",
    "request": "2.10.0",
    "async": "0.1.22",
    "ua-parser": "0.3.2",
    "underscore": "1.4.4",
    "fs.extra": "1.2.1"
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "less": "^4.2.0",
    "@types/node": "^22.5.0"
  }
}