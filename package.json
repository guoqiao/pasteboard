{
  "name": "pasteboard",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "npm run build:server && npm run build:client",
    "build:server": "tsc -p tsconfig.json",
    "build:client": "tsc -p tsconfig.client.json && node dist/scripts/build-assets.js",
    "start": "node dist/app.js",
    "run-local": "npm run build && LOCAL=true node dist/app.js"
  },
  "dependencies": {
    "async": "0.1.22",
    "cookie-parser": "^1.4.7",
    "easyimage": "0.1.3",
    "ejs": "^3.1.10",
    "errorhandler": "^1.5.1",
    "express": "^4.21.2",
    "formidable": "^2.1.5",
    "fs-extra": "^11.2.0",
    "knox": "0.9.2",
    "method-override": "^3.0.0",
    "morgan": "^1.10.0",
    "serve-favicon": "^2.5.0",
    "ua-parser": "0.3.2",
    "websocket": "1.0.8"
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "less": "^4.2.0",
    "@types/node": "^22.5.0"
  }
}
